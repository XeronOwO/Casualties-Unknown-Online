<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CasualtiesUnknownOnline.Tests</AssemblyName>
    <Product>Casualties Unknown: Online Tests</Product>
    <Version>0.1.0</Version>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <RootNamespace>CasualtiesUnknownOnline.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- BepInEx.Core comes via the Runtime project reference — its package source must be restored too -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 matches the tested assemblies (same TFM, zero compatibility risk) -->
    <ProjectReference Include="..\..\src\CasualtiesUnknownOnline.Runtime\CasualtiesUnknownOnline.Runtime.csproj" />
    <!-- Phase-3 contract tests: GameAdapter.dll is loaded REFLECTIVELY (never
         compile-referenced — it binds Unity/game assemblies), so only its
         build output is copied here (ExcludeAssets="compile" — no type
         references leak into the test compile). -->
    <ProjectReference Include="..\..\src\CasualtiesUnknownOnline.GameAdapter\CasualtiesUnknownOnline.GameAdapter.csproj"
                      ExcludeAssets="compile" Private="true" />
  </ItemGroup>

  <!-- The reflection host for the contract tests: the game assemblies (from
       references/, gitignored — see references/README.md) must sit beside the
       test output. netstandard.dll rides along — the Unity game assemblies
       reference the netstandard 2.1 facade (Unity's compatibility layer), which
       net48 does not provide. steam_api64.dll (native, unrelated) is excluded.
       MISSING references are a test FAILURE (the contract test names them),
       never a silent skip. -->
  <ItemGroup>
    <None Include="..\..\references\*.dll"
          Exclude="..\..\references\steam_api64.dll"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Phase-4 replay archive: every *.replay file ships with the test output —
       each file is one automated scenario (ReplayTests enumerates the folder,
       a missing file is a test failure, never a skip). -->
  <ItemGroup>
    <None Include="Replays\*.replay" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The event-replay matrix audit data (the check-event-replay gate's
       source) — a test asserts its integrity (ReplayMatrixDataTests). The
       entity-features CSV + narrative doc ride along for the narrative-vs-CSV
       consistency gate (EntityFeaturesDocConsistencyTests). -->
  <ItemGroup>
    <None Include="..\..\docs\event-replay-matrix.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\entity-features-matrix.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\entity-features.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
