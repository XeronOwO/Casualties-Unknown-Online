<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CasualtiesUnknownOnline</AssemblyName>
    <Product>Casualties Unknown: Online</Product>
    <Version>0.1.0</Version>
    <BepInExPluginGuid>CasualtiesUnknownOnline</BepInExPluginGuid>
    <BepInExPluginName>Casualties Unknown: Online</BepInExPluginName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <RootNamespace>CasualtiesUnknownOnline</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" PrivateAssets="all" />
    <PackageReference Include="BepInEx.PluginInfoProps" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasualtiesUnknownOnline.Runtime\CasualtiesUnknownOnline.Runtime.csproj" />
    <ProjectReference Include="..\CasualtiesUnknownOnline.GameAdapter\CasualtiesUnknownOnline.GameAdapter.csproj" />
  </ItemGroup>

  <!--
    NO game assembly here: the Game Adapter is the only framework project that
    references Assembly-CSharp (docs/development/agent-reference.md, repository
    layout), and this project's own code no longer touches a game type — the
    direct-join intent, the carry pump and the lobby policy all reach the game
    through the adapter's capability ports. GameAssemblyReferenceGateTests fails
    the build if a game assembly reference comes back.

    The UnityEngine modules below are the game's own Unity 2022.3 builds:
    the template's UnityEngine.Modules 5.6.0 NuGet package mismatched the
    runtime and Unity could not instantiate the plugin script ("could not be
    instantiated" in Player.log). Each reference below is the measured minimum —
    the module was removed, the project rebuilt, and the compiler named what went
    missing:
      UnityEngine / CoreModule       — BepInEx's BaseUnityPlugin derives from
                                       MonoBehaviour; Application, Debug, LogType.
      UnityEngine.InputLegacyModule  — Input.GetKeyDown and KeyCode for the
                                       console/quick-panel hotkeys.
      UnityEngine.IMGUIModule        — the Online UI overlay's IMGUI pass.
      UnityEngine.TextRenderingModule— GUIStyle/GUIText text in that pass.
      netstandard                    — the game's own copy, never the targeting pack's.
    SubsystemsModule and SharedInternalsModule were dropped by the same
    measurement. Re-run it (remove one, build, read the error) before adding a
    module back.
  -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>..\..\references\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\references\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\references\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\references\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\references\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>..\..\references\netstandard.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
</Project>
