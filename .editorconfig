# Code style configuration — STRICT MODE: every rule is error-severity and
# enforced at build time (EnforceCodeStyleInBuild in each csproj) plus via
# `dotnet format`. Imperfect code does not build.
root = true

[*]
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,xml,props,targets,config}]
indent_style = space
indent_size = 2

[*.cs]
indent_style = tab
tab_width = 4
indent_size = 4

# ---- Style rules (severity: error, enforced in build) ----

# Prefer `var` where the type is apparent (CLAUDE.md convention #2)
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error

# Prefer file-scoped namespaces
csharp_style_namespace_declarations = file_scoped:error

# Modern C#: expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:error
csharp_style_expression_bodied_properties = true:error
csharp_style_expression_bodied_operators = true:error
csharp_style_expression_bodied_indexers = true:error
csharp_style_expression_bodied_accessors = true:error

# Field/assignment style
dotnet_style_readonly_field = true:error
dotnet_style_prefer_compound_assignment = true:error
dotnet_style_prefer_simplified_interpolation = true:error

# ---- IDE diagnostics (severity: error) ----

# No fully-qualified names where a using/alias suffices (CLAUDE.md convention #2)
dotnet_diagnostic.IDE0001.severity = error
# Prefer `var` (IDE0007) and forbid explicit types when var is possible (IDE0008)
dotnet_diagnostic.IDE0007.severity = error
dotnet_diagnostic.IDE0008.severity = error
# Remove unnecessary usings / braces
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0011.severity = error
# Object/collection initializers
dotnet_diagnostic.IDE0017.severity = error
# Collection expressions (C# 12, compiles fine on net48): simplify initializers
dotnet_diagnostic.IDE0301.severity = error
# Prefer collection initializers over repeated Add calls
dotnet_diagnostic.IDE0028.severity = error
# IDE0031 (simplify null checks to ?.) is DISABLED: for Unity objects (Body,
# PlayerCamera, WorldGeneration, clones) null checks MUST use == null — the
# operator overload detects scene-reload-destroyed objects, while ?. (reference
# comparison) would throw MissingReferenceException on access. A global ?.
# rewrite would turn those checks back into the unsafe form (see CLAUDE.md
# convention #2 "Unity objects" exception).
dotnet_diagnostic.IDE0031.severity = none
# NOTE: is null / is not null over == null / != null is a documented convention
# (CLAUDE.md) but NOT enforced here — IDE0041 is IDE-only, the CLI analyzers
# never report it, so an editorconfig severity would be dead config.
# Constructors use block bodies, not expression bodies
dotnet_diagnostic.IDE0021.severity = error
# Prefer primary constructors (C# 12, pure compile-time on net48)
dotnet_diagnostic.IDE0290.severity = error
# Prefer readonly fields
dotnet_diagnostic.IDE0044.severity = error

# No underscore prefix required for fields (CLAUDE.md: game-binding fields keep
# game naming; CUO code uses underscore-prefixed private fields)
dotnet_diagnostic.IDE1006.severity = none
