<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CasualtiesUnknownOnline.Protocol</AssemblyName>
    <Product>Casualties Unknown: Online Protocol</Product>
    <Version>0.1.0</Version>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <RootNamespace>CasualtiesUnknownOnline.Protocol</RootNamespace>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <!--
    CUO Protocol: only stable wire DTOs and codecs.
    It must never reference GameState, Runtime, Unity, BepInEx, Steam, or game
    assemblies. DTOs are defined here so the kernel domain surface stays
    wire-free and the Runtime can map kernel facts to wire without leaking DTOs
    into the deterministic kernel.
  -->
  <ItemGroup>
    <PackageReference Include="protobuf-net" Version="3.2.56" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
