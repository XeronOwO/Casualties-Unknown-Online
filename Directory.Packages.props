<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- BepInEx 5 line (net48-compatible) -->
    <PackageVersion Include="BepInEx.Analyzers" Version="1.0.8" />
    <PackageVersion Include="BepInEx.Core" Version="5.4.21" />
    <PackageVersion Include="BepInEx.PluginInfoProps" Version="2.1.0" />

    <!-- Microsoft.Extensions 3.1.x is the net48-compatible line -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="3.1.32" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="3.1.32" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="3.1.32" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="3.1.32" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="3.1.32" />

    <!-- Misc / wire / mapping -->
    <PackageVersion Include="Mapster" Version="6.0.0" />
    <!-- The test output must carry this signed package copy instead of the game's
         own: the game ships a delay-signed Newtonsoft.Json, and the .NET Framework
         test host refuses it with 0x80131045 while Mapster scans the mapped
         members' attributes. Identical identity (13.0.0.0, 30ad4fe6b2a6aeed), so
         binding is unchanged — only the signature becomes verifiable. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- tools/CasualtiesUnknownOnline.ContractTool: assembly metadata read
         (snapshot) and write (test fixtures) without loading or executing the
         target assembly. Never referenced by the plugin. -->
    <PackageVersion Include="Mono.Cecil" Version="0.11.6" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />
    <PackageVersion Include="protobuf-net" Version="3.4.21" />

    <!-- The world archive format's serializer (docs/architecture/save-archive-format.md
         §3.4). 8.0.x is the last line shipping the net462 assembly. Its BCL
         support DLLs (System.Text.Encodings.Web, System.Memory, …) flow
         transitively; tools/deploy.ps1 copies them beside the plugin. -->
    <PackageVersion Include="System.Text.Json" Version="8.0.5" />

    <!-- Test tooling -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
