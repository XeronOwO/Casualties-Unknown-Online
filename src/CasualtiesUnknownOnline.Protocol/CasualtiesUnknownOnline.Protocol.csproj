<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CasualtiesUnknownOnline.Protocol</AssemblyName>
    <Product>Casualties Unknown: Online Protocol</Product>
    <Version>0.1.0</Version>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <RootNamespace>CasualtiesUnknownOnline.Protocol</RootNamespace>
    <!-- protobuf-net 3.4.x analyzer PBN0022 is a migration artifact for the
         existing wire DTOs' pre-IsRequired reference fields; the wire shapes are
         stable and the analyzer is not part of the CUO normative gates. -->
    <NoWarn>$(NoWarn);PBN0022</NoWarn>
  </PropertyGroup>

  <!--
    CUO Protocol: only stable wire DTOs and codecs.
    It must never reference GameState, Runtime, Unity, BepInEx, Steam, or game
    assemblies. DTOs are defined here so the kernel domain surface stays
    wire-free and the Runtime can map kernel facts to wire without leaking DTOs
    into the deterministic kernel.
  -->
  <ItemGroup>
    <PackageReference Include="protobuf-net" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
</Project>
