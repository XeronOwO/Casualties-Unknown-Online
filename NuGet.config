<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Centralized NuGet sources for the whole repository.
    BepInEx.* packages are only published to the BepInEx/Samboy feeds; all other
    packages come from nuget.org. Package Source Mapping is required alongside
    Central Package Management when more than one source is configured.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="nuget.bepinex.dev" value="https://nuget.bepinex.dev/v3/index.json" protocolVersion="3" />
    <add key="nuget.samboy.dev" value="https://nuget.samboy.dev/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.bepinex.dev">
      <package pattern="BepInEx.*" />
    </packageSource>
    <packageSource key="nuget.samboy.dev">
      <package pattern="BepInEx.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
