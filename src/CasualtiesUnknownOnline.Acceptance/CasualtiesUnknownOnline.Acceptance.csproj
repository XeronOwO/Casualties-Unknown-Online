<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CasualtiesUnknownOnline.Acceptance</AssemblyName>
    <Product>CUO Acceptance Channel</Product>
    <Version>0.1.0</Version>
    <BepInExPluginGuid>CasualtiesUnknownOnline.Acceptance</BepInExPluginGuid>
    <BepInExPluginName>CUO Acceptance Channel</BepInExPluginName>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <RootNamespace>CasualtiesUnknownOnline.Acceptance</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" />
    <PackageReference Include="BepInEx.PluginInfoProps" />
  </ItemGroup>

  <!--
    The acceptance channel's own assembly. It holds the instruments a batch drives the game with (the staged keyboard and
    pointer, and whatever joins them), and NOTHING the player runs: the shipped mod does not reference it and a production
    deploy does not copy it. The types keep the names they had inside the adapter, so the recipes and declarations that
    reach them by name through HotRepl keep working unchanged.
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\references\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\references\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\references\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\references\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\references\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>

</Project>
