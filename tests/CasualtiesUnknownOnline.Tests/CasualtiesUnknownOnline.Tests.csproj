<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CasualtiesUnknownOnline.Tests</AssemblyName>
    <Product>Casualties Unknown: Online Tests</Product>
    <Version>0.1.0</Version>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Nullable>enable</Nullable>
    <RootNamespace>CasualtiesUnknownOnline.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- BepInEx.Core comes via the Runtime project reference — its package source must be restored too -->
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- net48 matches the tested assemblies (same TFM, zero compatibility risk) -->
    <ProjectReference Include="..\..\src\CasualtiesUnknownOnline.GameState\CasualtiesUnknownOnline.GameState.csproj" />
    <ProjectReference Include="..\..\src\CasualtiesUnknownOnline.Protocol\CasualtiesUnknownOnline.Protocol.csproj" />
    <ProjectReference Include="..\..\src\CasualtiesUnknownOnline.Runtime\CasualtiesUnknownOnline.Runtime.csproj" />
    <Reference Include="Steamworks.NET">
      <HintPath>..\..\references\Steamworks.NET.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <!-- The reflection-host DLLs are Reference items so Visual Studio groups
         them under the project Dependencies node. Aliases=GameRef keeps their
         global types (e.g. Assembly-CSharp.RunSetting) out of the test compile
         namespace while Private=True places them beside the test assembly. -->
    <Reference Include="0Harmony">
      <HintPath>..\..\references\0Harmony.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\..\references\UnityEngine.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\references\Assembly-CSharp.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>..\..\references\netstandard.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\..\references\Newtonsoft.Json.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>..\..\references\UnityEngine.AnimationModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>..\..\references\UnityEngine.AudioModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\..\references\UnityEngine.CoreModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>..\..\references\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\..\references\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>..\..\references\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>..\..\references\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.SharedInternalsModule">
      <HintPath>..\..\references\UnityEngine.SharedInternalsModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.SubsystemsModule">
      <HintPath>..\..\references\UnityEngine.SubsystemsModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>..\..\references\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.TilemapModule">
      <HintPath>..\..\references\UnityEngine.TilemapModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\..\references\UnityEngine.UI.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>..\..\references\UnityEngine.UIModule.dll</HintPath>
      <Private>True</Private>
      <Aliases>GameRef</Aliases>
    </Reference>
    <!-- Phase-3 contract tests: GameAdapter.dll is loaded REFLECTIVELY (never
         compile-referenced — it binds Unity/game assemblies), so only its
         build output is copied here (ExcludeAssets="compile" — no type
         references leak into the test compile). -->
    <ProjectReference Include="..\..\src\CasualtiesUnknownOnline.GameAdapter\CasualtiesUnknownOnline.GameAdapter.csproj"
                      ExcludeAssets="compile" Private="true" />
  </ItemGroup>

  <!-- Phase-4 replay archive: every *.replay file ships with the test output —
       each file is one automated scenario (ReplayTests enumerates the folder,
       a missing file is a test failure, never a skip). -->
  <ItemGroup>
    <None Include="Replays\*.replay" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The event-replay matrix audit data (the check-event-replay gate's
       source) — a test asserts its integrity (ReplayMatrixDataTests). The
       entity-features CSV + narrative doc ride along for the narrative-vs-CSV
       consistency gate (EntityFeaturesDocConsistencyTests). -->
  <ItemGroup>
    <None Include="..\..\docs\event-replay-matrix.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\entity-features-matrix.csv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\docs\entity-features.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
