<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>CasualtiesUnknownOnline.Core</AssemblyName>
    <Product>Casualties Unknown: Online Core</Product>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <RootNamespace>CasualtiesUnknownOnline.Core</RootNamespace>
  </PropertyGroup>

  <!--
    CUO Core: network protocol, host/guest state machine, session, logging.
    Must NEVER reference game assemblies or BepInEx — dependency flows from
    Plugin/GameAdapter down into Core, never the other way.
  -->

  <!--
    Steamworks.NET 2025.163.0 — gitignored, copied from the KrokMP install
    (see references/README.md). Latest NuGet releases are netstandard2.1-only,
    incompatible with net452; direct reference sidesteps the TFM check.
  -->
  <ItemGroup>
    <Reference Include="Steamworks.NET">
      <HintPath>..\..\references\Steamworks.NET.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework.TrimEnd(`0123456789`))' == 'net'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
